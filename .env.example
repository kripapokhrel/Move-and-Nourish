# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used for email confirmation redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Needed from step 8 (workouts) onward. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Server-only. Weekly Sunday email (step 12).
# Gmail: turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Supabase -> Project Settings -> API Keys -> secret key. Lets the weekly job read every user's data. Never expose it.
SUPABASE_SECRET_KEY=
# Any long random string. The scheduler sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
